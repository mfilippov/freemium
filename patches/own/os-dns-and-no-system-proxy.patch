Resolve names only through the OS and ignore the OS proxy settings.

- DNS: the built-in DNS client and browser-level DNS over HTTPS are off, so the
  OS resolver (and its own DoH settings) handles every lookup; the Secure DNS
  setting is hidden.
- Proxy: the OS proxy configuration (and with it WPAD/PAC auto-detection) is
  not read; connections are direct unless a proxy comes from the command line,
  a policy or an extension. The settings row that opens the OS proxy settings is
  hidden (it stays when a policy or an extension sets a proxy).
--- a/chrome/browser/net/proxy_service_factory.cc
+++ b/chrome/browser/net/proxy_service_factory.cc
@@ -42,8 +42,10 @@
   // configuration in case nothing is configured through prefs (Note: prefs
   // include command line and configuration policy).
 
-  base_service = net::ProxyConfigService::CreateSystemProxyConfigService(
-      base::SingleThreadTaskRunner::GetCurrentDefault());
+  // The OS proxy settings are ignored: without prefs (command line, policy,
+  // extension) connections are direct, so there are no WPAD/PAC lookups.
+  // base_service = net::ProxyConfigService::CreateSystemProxyConfigService(
+  //     base::SingleThreadTaskRunner::GetCurrentDefault());
 #endif  // !BUILDFLAG(IS_CHROMEOS)
 
   return tracker->CreateTrackingProxyConfigService(std::move(base_service));
